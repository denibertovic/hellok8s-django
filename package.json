{
  "name": "hellok8s-django",
  "packageManager": "yarn@4.14.1",
  "dependencies": {
    "@tailwindcss/cli": "4.1.0",
    "tailwindcss": "4.1.0"
  },
  "scripts": {
    "build-css": "tailwindcss -i ./core/static/css/input.css -o ./core/static/css/output.css",
    "watch-css": "tailwindcss -i ./core/static/css/input.css -o ./core/static/css/output.css --watch"
  }
}
